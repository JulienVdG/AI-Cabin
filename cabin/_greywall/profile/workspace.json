// Base workspace profile - shared by all agents
// Filesystem access for workspace operations
{
  "filesystem": {
    "allowRead": [
      "/"
    ],
    "allowWrite": [
      ".",
      "~/desk"
    ],
    "denyRead": [
      "~/.ssh/id_*",
      "~/.gnupg/**",
      ".env",
      ".env.*",
      "/etc/shadow",
      "/root"
    ],
    "denyWrite": [
      "~/.bashrc",
      "~/.bash_profile",
      "~/.zshrc",
      "~/.zprofile",
      "~/.profile",
      "~/.ssh",
      "~/.gnupg"
    ]
  },
  "schemaVersion": 1
}
