#!/bin/bash
for f in /etc/profile.d/ai-cabin-*.sh; do [ -r "$f" ] && . "$f"; done
gw_args=()
if [ -n "$GREYWALL_PROFILE" ]; then
  gw_args+=(--profile "$GREYWALL_PROFILE")
else
  echo "cabin: GREYWALL_PROFILE is empty; greywall will auto-detect by command name" >&2
fi
# shellcheck disable=SC2086  # intentional word-splitting: GREYWALL_ARGS is a flag list
gw_args+=( $GREYWALL_ARGS )
if [ "$GREYWALL_SANDBOX" = "1" ]; then
  # Inner: cd to the relpath once, then consume the marker so a later launch
  # from within the sandbox uses the current CWD.
  if [ -n "$CABIN_DO_REL_CD" ]; then
    cd "$CABIN_DO_REL_CD" || { echo "cabin: cannot cd to $CABIN_DO_REL_CD" >&2; exit 1; }
    unset CABIN_DO_REL_CD
  fi
  exec /opt/pi/pi "$@"
else
  # Outer: cd to the workdir root (greywall anchors here), record the relpath,
  # then re-exec self under greywall.
  cd "$CONTAINER_WORKDIR" || { echo "cabin: CONTAINER_WORKDIR ($CONTAINER_WORKDIR) does not exist" >&2; exit 1; }
  export CABIN_DO_REL_CD="$CONTAINER_WORKDIR/${CABIN_REL_PATH:-}"
  exec greywall "${gw_args[@]}" -- "$0" "$@"
fi
