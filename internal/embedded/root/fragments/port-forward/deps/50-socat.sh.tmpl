#!/bin/bash
# Forward localhost:{{default .port .listen}} -> {{.host}}:{{.port}}.
# The optional listen attr (default: the target port) decouples the local
# socket from the target port.
# One socat process per forwarded port (fork handles connections).
echo "[entrypoint] Starting socat forward {{.host}}:{{.port}} on localhost:{{default .port .listen}}..."
socat TCP-LISTEN:{{default .port .listen}},fork,reuseaddr TCP:{{.host}}:{{.port}} &
